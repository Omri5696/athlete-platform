# Copy to sync/.env — gitignored, stays on your machine only.
#
# Supabase credentials load automatically from the project's ../.env.local,
# so you normally only need the two GARMIN_ lines below.

GARMIN_EMAIL=""
GARMIN_PASSWORD=""

# The athlete of the experiment (already created in קשב):
KESHEV_ATHLETE_ID="c90279cf-1910-42be-8243-822df753da98"

# --- more than one athlete? delete the three lines above and create
#     sync/accounts.json instead:
#   [
#     { "athlete_id": "...", "email": "...", "password": "..." }
#   ]

# --- override Supabase only if ../.env.local isn't found:
